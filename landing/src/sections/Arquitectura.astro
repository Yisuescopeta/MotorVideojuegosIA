---
import SectionWrapper from '../components/SectionWrapper.astro';
import PixelCard from '../components/PixelCard.astro';
---

<SectionWrapper id="arquitectura" style="padding: var(--section-padding) 0; background: var(--bg-alt); border-top: 1px solid var(--border);">
  <div class="container">
    <h2 class="font-h1 stagger-child" style="text-align: center;">Arquitectura</h2>
    <p class="font-body stagger-child" style="color: var(--text-muted); text-align: center; margin-top: 12px;">
      Conceptos principales del motor
    </p>

    <!-- Cards grid -->
    <div class="arch-grid">
      <PixelCard className="stagger-child arch-card">
        <h3 class="font-h2">Scene</h3>
        <p class="font-body-small" style="color: var(--text-secondary); margin-top: 12px;">
          Fuente persistente de verdad. Contiene entidades, componentes serializables, reglas, metadata y referencias de prefab.
        </p>
        <span class="tag" style="color: var(--code-blue); border-color: var(--code-blue);">SERIALIZABLE</span>
      </PixelCard>

      <PixelCard className="stagger-child arch-card">
        <h3 class="font-h2">World</h3>
        <p class="font-body-small" style="color: var(--text-secondary); margin-top: 12px;">
          Proyeccion operativa usada por editor y runtime. No sustituye a la escena persistente.
        </p>
        <span class="tag" style="color: var(--code-green); border-color: var(--code-green);">RUNTIME</span>
      </PixelCard>

      <PixelCard className="stagger-child arch-card">
        <h3 class="font-h2">SceneManager</h3>
        <p class="font-body-small" style="color: var(--text-secondary); margin-top: 12px;">
          Coordina workspace, authoring, dirty state, historial y el ciclo EDIT → PLAY → STOP.
        </p>
        <span class="tag" style="color: var(--code-yellow); border-color: var(--code-yellow);">CORE</span>
      </PixelCard>

      <PixelCard className="stagger-child arch-card">
        <h3 class="font-h2">EngineAPI</h3>
        <p class="font-body-small" style="color: var(--text-secondary); margin-top: 12px;">
          Fachada publica para agentes, tests, CLI y automatizacion. Punto de entrada estable para todo desarrollo externo.
        </p>
        <span class="tag" style="color: var(--code-green); border-color: var(--code-green);">API PUBLICA</span>
      </PixelCard>
    </div>

    <!-- Architecture diagram -->
    <div class="arch-diagram stagger-child">
      <div class="arch-top-row">
        <div class="arch-box">
          <span class="font-label">Editor</span>
        </div>
        <div class="arch-box">
          <span class="font-label">IA</span>
        </div>
        <div class="arch-box">
          <span class="font-label">CLI</span>
        </div>
      </div>
      <div class="arch-arrow-down">↓</div>
      <div class="arch-box" style="border-color: var(--border-hover);">
        <span class="font-label">EngineAPI</span>
      </div>
      <div class="arch-arrow-down">↓</div>
      <div class="arch-box" style="border-color: var(--border-hover);">
        <span class="font-label">SceneManager</span>
      </div>
      <div class="arch-arrow-down">↓</div>
      <div class="arch-bottom-row">
        <div class="arch-box">
          <span class="font-label">Scene</span>
        </div>
        <div class="arch-arrows-h">
          <span>←</span><span>→</span>
        </div>
        <div class="arch-box">
          <span class="font-label">World</span>
        </div>
        <div class="arch-arrows-h">
          <span>←</span><span>→</span>
        </div>
        <div class="arch-box">
          <span class="font-label">Runtime</span>
        </div>
      </div>
    </div>
  </div>
</SectionWrapper>

<style>
  .arch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--card-gap);
    margin-top: 48px;
  }

  .tag {
    display: inline-block;
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    border: 1px solid;
    padding: 6px 10px;
    margin-top: 16px;
  }

  .arch-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 64px;
    gap: 0;
  }

  .arch-top-row {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .arch-bottom-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .arch-box {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 12px 20px;
    text-align: center;
    color: var(--text-secondary);
  }

  .arch-arrow-down {
    font-family: 'Press Start 2P', monospace;
    font-size: 14px;
    color: var(--text-muted);
    padding: 8px 0;
    line-height: 1;
  }

  .arch-arrows-h {
    display: flex;
    gap: 2px;
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    color: var(--text-muted);
  }

  @media (max-width: 767px) {
    .arch-grid {
      grid-template-columns: 1fr;
    }

    .arch-top-row {
      gap: 12px;
    }

    .arch-bottom-row {
      flex-direction: column;
      gap: 8px;
    }

    .arch-arrows-h {
      transform: rotate(90deg);
    }
  }
</style>

<style is:global>
  #arquitectura .arch-card {
    padding: var(--card-padding);
  }
</style>
