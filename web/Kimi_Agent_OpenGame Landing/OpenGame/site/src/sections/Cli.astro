---
import SectionWrapper from '../components/SectionWrapper.astro';
import TerminalBlock from '../components/TerminalBlock.astro';
import PixelCard from '../components/PixelCard.astro';
---

<SectionWrapper id="cli" style="padding: var(--section-padding) 0; background: var(--bg-alt); border-top: 1px solid var(--border);">
  <div class="container">
    <h2 class="font-h1 stagger-child" style="text-align: center;">CLI oficial motor</h2>
    <p class="font-body stagger-child" style="color: var(--text-muted); text-align: center; margin-top: 12px;">
      Interfaz de linea de comandos para automatizacion
    </p>

    <!-- Terminal block -->
    <div class="stagger-child" style="margin-top: 48px; max-width: var(--max-width); margin-left: auto; margin-right: auto;">
      <TerminalBlock>
        <div class="font-code">
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cmd">py -m motor doctor --project . --json</span>
          </div>
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cmd">py -m motor capabilities --json</span>
          </div>
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cmd">py -m motor scene list --project . --json</span>
          </div>
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cmd">py -m motor project bootstrap-ai --project .</span>
          </div>
        </div>
      </TerminalBlock>
    </div>

    <!-- Command cards -->
    <div class="cli-cards">
      <PixelCard className="stagger-child cli-card">
        <h3 class="font-h2" style="color: var(--code-green);">doctor</h3>
        <p class="font-body-small" style="color: var(--text-secondary); margin-top: 12px;">
          Diagnostico del proyecto
        </p>
      </PixelCard>

      <PixelCard className="stagger-child cli-card">
        <h3 class="font-h2" style="color: var(--code-green);">scene list</h3>
        <p class="font-body-small" style="color: var(--text-secondary); margin-top: 12px;">
          Inspeccion de escenas
        </p>
      </PixelCard>

      <PixelCard className="stagger-child cli-card">
        <h3 class="font-h2" style="color: var(--code-green);">export build</h3>
        <p class="font-body-small" style="color: var(--text-secondary); margin-top: 12px;">
          Exportacion de builds
        </p>
      </PixelCard>

      <PixelCard className="stagger-child cli-card">
        <h3 class="font-h2" style="color: var(--code-green);">ai start</h3>
        <p class="font-body-small" style="color: var(--text-secondary); margin-top: 12px;">
          Entrada compacta para agentes IA
        </p>
      </PixelCard>
    </div>
  </div>
</SectionWrapper>

<style>
  .cli-line {
    margin: 6px 0;
  }

  .cli-prompt {
    color: var(--code-green);
    margin-right: 8px;
  }

  .cli-cmd {
    color: var(--text-primary);
  }

  .cli-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--card-gap);
    margin-top: 48px;
  }

  .cli-card {
    padding: 20px;
  }

  @media (max-width: 991px) {
    .cli-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .cli-cards {
      grid-template-columns: 1fr;
    }
  }
</style>