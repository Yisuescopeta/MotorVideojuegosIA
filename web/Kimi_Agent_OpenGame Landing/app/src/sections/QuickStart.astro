---
import SectionWrapper from '../components/SectionWrapper.astro';
import TerminalBlock from '../components/TerminalBlock.astro';
---

<SectionWrapper style="padding: var(--section-padding) 0; background: var(--bg); border-top: 1px solid var(--border);">
  <div class="container">
    <h2 class="font-h1 stagger-child" style="text-align: center;">Quick start</h2>
    <p class="font-body stagger-child" style="color: var(--text-muted); text-align: center; margin-top: 12px;">
      Ponte en marcha en minutos
    </p>

    <div class="stagger-child" style="margin-top: 48px; max-width: 700px; margin-left: auto; margin-right: auto;">
      <TerminalBlock>
        <div class="font-code">
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cmd">py -m pip install -r requirements.txt</span>
          </div>
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cmd">py -m pip install -e .[dev]</span>
          </div>
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cmd">py -m motor --help</span>
          </div>
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cmd">py main.py</span>
          </div>
        </div>
      </TerminalBlock>
    </div>

    <div class="stagger-child" style="margin-top: 24px; text-align: center;">
      <p class="font-body-small" style="color: var(--code-yellow); display: inline-flex; align-items: center; gap: 8px;">
        <span style="font-size: 16px;">&#9432;</span>
        Requiere Python 3.11 o superior.
      </p>
    </div>
  </div>
</SectionWrapper>

<style>
  .cli-line {
    margin: 6px 0;
  }

  .cli-prompt {
    color: var(--code-green);
    margin-right: 8px;
  }

  .cli-cmd {
    color: var(--text-primary);
  }
</style>