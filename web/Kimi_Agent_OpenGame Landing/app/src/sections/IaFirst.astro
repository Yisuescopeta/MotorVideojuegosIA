---
import SectionWrapper from '../components/SectionWrapper.astro';
import TerminalBlock from '../components/TerminalBlock.astro';

const codeBlock = `<span style="color: var(--code-yellow);">from</span> engine.api <span style="color: var(--code-yellow);">import</span> EngineAPI

api = <span style="color: var(--text-primary);">EngineAPI</span>(project_root=<span style="color: var(--code-blue);">"."</span>)
api.<span style="color: var(--code-green);">load_scene</span>(<span style="color: var(--code-blue);">"levels/main_scene.json"</span>)
api.<span style="color: var(--code-green);">create_entity</span>(<span style="color: var(--code-blue);">"Player"</span>, components={
    <span style="color: var(--code-blue);">"Transform"</span>: {<span style="color: var(--code-blue);">"x"</span>: <span style="color: var(--code-yellow);">100</span>, <span style="color: var(--code-blue);">"y"</span>: <span style="color: var(--code-yellow);">200</span>}
})
api.<span style="color: var(--code-green);">save_scene</span>()
api.<span style="color: var(--code-green);">shutdown</span>()`;
---

<SectionWrapper id="ia-first" style="padding: var(--section-padding) 0; background: var(--bg); border-top: 1px solid var(--border);">
  <div class="container">
    <div class="ia-grid">
      <!-- Left column -->
      <div class="ia-left">
        <h2 class="font-h1 stagger-child">IA-first, pero sin humo</h2>
        <p class="font-body stagger-child" style="color: var(--text-secondary); margin-top: 20px;">
          El motor expone una CLI oficial y una EngineAPI para que herramientas externas, tests y agentes IA puedan consultar, modificar y validar proyectos sin depender de tocar internals privados.
        </p>
        <div class="stagger-child" style="margin-top: 16px; border-left: 3px solid var(--code-green); padding-left: 12px;">
          <p class="font-body-small" style="color: var(--text-muted); margin: 0;">
            Disenado para agentes. Sin promesas falsas.
          </p>
        </div>
      </div>

      <!-- Right column — Code block -->
      <div class="ia-right stagger-child">
        <TerminalBlock>
          <pre class="font-code" set:html={codeBlock}></pre>
        </TerminalBlock>
      </div>
    </div>
  </div>
</SectionWrapper>

<style>
  .ia-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 767px) {
    .ia-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>