  "command": {
    "queen": {
      "description": "Queen orchestrator: bounded, safe, verifiable multi-agent programming flow",
      "template": "I want you to act as the QUEEN orchestrator agent. Follow this cycle exactly: RECON -> TEST CONTRACT -> PLAN -> CRITICA DEL PLAN -> IMPLEMENTAR -> DOCUMENTAR -> VALIDAR -> REVIEW -> AI AUDIT -> COMMIT -> REPORTE. Long Task cycle: LOAD PLAN -> PLAN SYNC -> TEST CONTRACT -> IMPLEMENTAR FASE -> DOCUMENTAR -> VALIDAR -> REVIEW -> AI AUDIT -> UPDATE PLAN -> NEXT PHASE | COMMIT | BLOCK. UPDATE PLAN records AI AUDIT before advancing, blocking, or closing. Commit only after TEST CONTRACT, docs, validation, review, and AI audit pass. Max cycles: 5.\n\nUser task: $ARGUMENTS\n\nFollow the queen system prompt in .opencode/agents/queen.md.",
      "agent": "queen",
      "model": "openai/gpt-5.4-mini"
    },
    "godot": {
      "description": "Godot analysis & adaptation: analiza codigo Godot, compara con el motor, implementa features adaptadas",
      "template": "I want you to act as the QUEEN orchestrator agent. This task requires Godot source code analysis and feature adaptation to OpenGame. Use the godot-source-analyzer, godot-gap-analyzer, and godot-adapter sub-agents as needed. Load the godot-feature-adapter skill for Godot-to-Motor mappings.\n\nUser task: $ARGUMENTS\n\nReference docs:\n- .opencode/agents/godot-source-analyzer.md\n- .opencode/agents/godot-gap-analyzer.md\n- .opencode/agents/godot-adapter.md\n- .agents/skills/godot-feature-adapter/SKILL.md",
      "agent": "queen",
      "model": "opencode-go/deepseek-v4-pro"
    }
